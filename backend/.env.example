# Copy to backend/.env and adjust. Every value has a sensible default.
APP_NAME=SAQYA AI API
LOG_LEVEL=INFO

# Folder produced by notebooks/rag_pipeline.ipynb (relative to backend/)
VECTOR_STORE_DIR=data/vector_store
# Leave empty to use the values saved in data/vector_store/rag_config.json
COLLECTION_NAME=
EMBEDDING_MODEL=

# Retrieval
TOP_K=6
# Leave empty to use the threshold the notebook calibrated (saved in rag_config.json)
MIN_SIMILARITY=
# Keyword search (BM25) fused with the embedding search; false = embeddings only
HYBRID_SEARCH=true

# ---- Fusion settings (defaults = the values the app has always used; scripts/evaluate.py --tune compares others
# on the validation questions)
RRF_K=60
RETRIEVAL_CANDIDATES=30
BM25_K1=1.5
BM25_B=0.75
# weight of the keyword ranking next to the embeddings (1 = equal, 0 = embeddings only) and whether the best keyword
# match always keeps a place; choose with scripts/evaluate.py --tune
KEYWORD_WEIGHT=1.0
KEYWORD_SEAT=true

# Local LLM served by Ollama (must handle Arabic: qwen2.5:3b, qwen2.5:7b, aya-expanse:8b, qwen3:4b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
TEMPERATURE=0.0
# Context window (tokens). Must fit 6 Arabic passages + the instructions; Ollama's default is too small.
OLLAMA_NUM_CTX=8192
# Only for "thinking" models such as qwen3: set to false so they answer directly
OLLAMA_THINK=

# Also search with the question translated Arabic <-> English (one extra short LLM call)
QUERY_TRANSLATION=true
# Check each answer (citations, numbers, repeated question, refusal) and let the LLM retry once
SELF_CHECK=true

# Thumbs up / down from the chat UI (POST /feedback), one JSON object per line (relative to backend/)
FEEDBACK_FILE=data/feedback.jsonl

# ---- Voice (pip install faster-whisper edge-tts; both are in requirements.txt)
# Speech to text, local. large-v3-turbo understands Egyptian Arabic well (~1.6 GB, downloaded on first use);
# small is ~3x faster on a slow CPU, medium is in between
WHISPER_MODEL=large-v3-turbo
# auto = NVIDIA GPU if CUDA is set up, otherwise CPU; or cpu / cuda
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
# true = load Whisper at startup, so the first voice question is not slow
WHISPER_PRELOAD=false
# Spoken answers: Microsoft Edge neural voices (needs internet). Egyptian voices for Arabic.
TTS_RATE=-5%
TTS_VOICE_AR_FEMALE=ar-EG-SalmaNeural
TTS_VOICE_AR_MALE=ar-EG-ShakirNeural
TTS_VOICE_EN_FEMALE=en-US-JennyNeural
TTS_VOICE_EN_MALE=en-US-GuyNeural
# Optional, more natural voice: Google Gemini TTS (speaks Egyptian or formal Arabic on request).
# Get a free key at https://aistudio.google.com/apikey ; empty = only the Edge voices are offered.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE_FEMALE=Kore
GEMINI_TTS_VOICE_MALE=Charon

# ---- Beyond the documents: farming questions the library doesn't answer (pip install ddgs trafilatura)
# Search the web (free metasearch: Wikipedia, DuckDuckGo, Bing, Brave... no key needed)
WEB_SEARCH=true
WEB_SEARCH_BACKEND=auto
WEB_MAX_PAGES=4
WEB_TIMEOUT=6
# Empty = the library's relevance gate minus 0.12 (at least 0.4)
WEB_MIN_SIMILARITY=
# Extra sites to rank first / never use (comma-separated; FAO, ministries, universities... and social media,
# video and shopping sites are built in)
WEB_TRUSTED_DOMAINS=
WEB_BLOCKED_DOMAINS=
# Keep what web answers cite and what attached agricultural documents say, for later questions
LEARNING=true
LEARNED_DIR=data/learned
LEARNED_MAX_PASSAGES=20000
# Empty = the same as the web's (what answered once answers again)
LEARNED_MIN_SIMILARITY=
# When no source answers a farming question, answer from general knowledge (marked in the chat)
GENERAL_KNOWLEDGE=true

# ---- Documents attached in the chat (temporary: cleaned, kept for the chat session, then deleted)
# Folder for their clean PDFs, one sub-folder per chat session; emptied when the backend starts and stops.
# Empty = <system temp folder>/saqya-uploads
UPLOADS_DIR=
MAX_UPLOAD_MB=25
MAX_DOCUMENTS=20
DOCUMENTS_PER_SESSION=5
MAX_DOCUMENT_CHUNKS=2500
# A document nobody asked about for this long is deleted (a chat closed without saying so)
DOCUMENT_TTL_MINUTES=180
# Make a clean PDF of each attached document (Playwright's Chromium if installed, else PyMuPDF)
DOCUMENT_CLEAN_PDF=true
DOCUMENT_MIN_SIMILARITY=0.3

# ---- Optional AI/ML layers (docs/ai-ml-engineering.md). All off: turn one on only after scripts/evaluate.py
# shows it helps. With all of them off the app behaves exactly as before.
# Cross-encoder reranking (first: python scripts/download_models.py reranker)
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATES=30
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=auto
RERANKER_ALLOW_DOWNLOAD=false
# jinaai/jina-reranker-v2-base-multilingual needs this (and is licensed for non-commercial use only)
RERANKER_TRUST_REMOTE_CODE=false
# Extra search phrasings from the glossary and the bulletins' headings (no LLM)
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_MAX_VARIANTS=2
QUERY_EXPANSION_MAX_TERMS=4
QUERY_EXPANSION_WEIGHT=0.25
# Return crop / categories / intent / symptoms / missing information with each answer
QUERY_CLASSIFICATION_ENABLED=false
# A verdict per statement of each answer; NLI model optional (python scripts/download_models.py nli)
CLAIM_VERIFICATION_ENABLED=false
CLAIM_VERIFICATION_NLI=false
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_ALLOW_DOWNLOAD=false
# answer / qualify / ask / abstain (calibration file: python scripts/evaluate.py --calibrate)
CONFIDENCE_CALIBRATION_ENABLED=false
CONFIDENCE_CALIBRATION_FILE=data/confidence_calibration.json
# Use the separate store embedded with a fine-tuned model (scripts/build_collection.py); falls back to the original
FINE_TUNED_EMBEDDINGS_ENABLED=false
FINE_TUNED_STORE_DIR=data/vector_store_finetuned

# ---- Plant-disease detection from photos (docs/computer-vision-handoff.md). No model ships with the project yet:
# put a Hugging Face image-classification model in models/plant-disease/ and set VISION_ENABLED=true
VISION_ENABLED=false
VISION_MODEL=models/plant-disease
VISION_DEVICE=auto
VISION_ALLOW_DOWNLOAD=false
# placeholder: choose it from your validation photos
VISION_MIN_CONFIDENCE=0.7
VISION_TOP_K=3
VISION_MAX_MB=10

# ---- LangSmith tracing (optional: pip install langsmith). Never required; off unless enabled AND a key is set
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=saqya-ai
# e.g. https://eu.api.smith.langchain.com for the EU region; empty = the default
LANGSMITH_ENDPOINT=
# false: questions and answers are sent as their length only
LANGSMITH_LOG_TEXT=true
# characters of each passage sent with a trace (0: only source, pages and scores)
LANGSMITH_PASSAGE_CHARS=200

# Comma-separated origins allowed to call the API (Streamlit default port is 8501)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
