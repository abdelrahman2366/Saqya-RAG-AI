# Copy to frontend/.env
API_BASE_URL=http://localhost:8000
# Seconds to wait for an answer (local LLMs can be slow on the first question)
REQUEST_TIMEOUT=180
# Address at which the *browser* reaches the backend, for the live voice (GET /voice/stream).
# Leave it out when that is the same as API_BASE_URL (the usual case on one computer).
# PUBLIC_API_URL=http://localhost:8000
